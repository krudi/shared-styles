{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "agentGuidance": false,
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "storybook-static/**"],
            "inputs": ["$TURBO_DEFAULT$", "**/.env*"],
            "outputLogs": "new-only"
        },
        "dev": {
            "persistent": true,
            "cache": false
        },
        "clean": {
            "cache": false
        },
        "typecheck": {
            "dependsOn": ["^typecheck", "^build"],
            "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "**/*.tsx", "tsconfig*.json"],
            "outputs": [".cache/tsbuildinfo.json"],
            "outputLogs": "new-only"
        },
        "test:storybook": {
            "dependsOn": ["^test:storybook", "@krudi/styles#build"],
            "outputLogs": "new-only"
        },
        "test:storybook:coverage": {
            "dependsOn": ["^test:storybook:coverage", "@krudi/styles#build"],
            "outputs": ["coverage/**"],
            "outputLogs": "new-only"
        },
        "preview": {
            "dependsOn": ["^build"],
            "cache": false
        }
    }
}
