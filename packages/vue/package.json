{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@krudi/vue",
    "version": "0.1.0",
    "private": false,
    "description": "Vue component wrappers for @krudi/styles CSS classes.",
    "keywords": [
        "vue",
        "components",
        "ui",
        "css",
        "krudi"
    ],
    "homepage": "https://github.com/krudi/shared-styles#readme",
    "bugs": {
        "url": "https://github.com/krudi/shared-styles/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krudi/shared-styles.git"
    },
    "license": "MIT",
    "author": {
        "name": "krudi",
        "email": "patryk.kudlik@gmail.com",
        "url": "https://krudi.io"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "vite build",
        "clean": "rm -rf .turbo .cache dist node_modules",
        "dev": "vite build --watch",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "vue-tsc -p tsconfig.json --noEmit"
    },
    "peerDependencies": {
        "vue": ">=3"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "typescript": "^6.0.2",
        "vite": "^8.2.0",
        "vite-plugin-dts": "^5.0.3",
        "vue": "^3.5.41",
        "vue-tsc": "^3.3.9",
        "vitest": "^4.1.10",
        "@testing-library/vue": "^8.1.0",
        "@testing-library/user-event": "^14.6.3",
        "@testing-library/jest-dom": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.10",
        "jsdom": "^30.0.1"
    },
    "engines": {
        "node": ">= 24.19.0"
    }
}
