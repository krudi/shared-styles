{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@krudi/react",
    "version": "0.1.0",
    "private": false,
    "description": "React component wrappers for @krudi/styles CSS classes.",
    "keywords": [
        "react",
        "components",
        "ui",
        "css",
        "krudi"
    ],
    "homepage": "https://github.com/krudi/shared-styles#readme",
    "bugs": {
        "url": "https://github.com/krudi/shared-styles/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krudi/shared-styles.git"
    },
    "license": "MIT",
    "author": {
        "name": "krudi",
        "email": "patryk.kudlik@gmail.com",
        "url": "https://krudi.io"
    },
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "sideEffects": false,
    "peerDependencies": {
        "react": ">=19",
        "react-dom": ">=19"
    },
    "scripts": {
        "build": "vite build",
        "clean": "rm -rf .turbo .cache dist node_modules",
        "dev": "vite build --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "engines": {
        "node": ">= 26.13.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "react": "^19.3.1",
        "typescript": "^6.0.3",
        "unplugin-dts": "^1.1.2",
        "vite": "^8.3.5"
    }
}
